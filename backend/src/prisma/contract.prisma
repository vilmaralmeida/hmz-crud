// use prisma-8

model User {
  id        Int              @id @default(autoincrement())
  email     String           @unique
  firstName String           @map("first_name")
  lastName  String           @map("last_name")
  avatar    String?
  slug      String           @unique
  password  String
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}